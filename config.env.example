# PQS IP 守护配置 —— /etc/pqs-guard/config.env（权限 600），一键脚本会自动生成
# 多台服务器必须各用【不同的】Telegram 机器人 token（同一个 token 两处轮询会冲突）

# 留空则使用主机名
SERVER_NAME=

# 时区：影响显示的时间和「今日已换 x 次」的计算（台湾/中国均为 UTC+8）
TZ=Asia/Shanghai

# ── Telegram ──
# 在 @BotFather 创建机器人获得
TG_BOT_TOKEN=
# 允许控制机器人的 Telegram 用户 ID，多个用逗号分隔（可在 @userinfobot 查询）
TG_ALLOWED_IDS=
# 通知发送到哪里，留空则发给第一个允许的用户
TG_NOTIFY_CHAT_ID=

# ── PQS 换 IP 接口（PQS 后台生成的 API 地址）──
PQS_CHANGE_IP_URL=

# ── 自动检测 ──
# 机器人里也可以随时 /auto on|off
AUTO_CHANGE=true
CHECK_GFW=true
CHECK_NETFLIX=true
# full=必须能看非自制剧；originals=能看自制剧就行
NF_REQUIRE=full
# 检测间隔（秒）
CHECK_INTERVAL=300
# 连续失败几次才换，防误判
FAIL_THRESHOLD=2
# 两次自动换 IP 最短间隔（秒）
CHANGE_COOLDOWN=600
# 每日自动换 IP 上限（手动不受限，但计入次数）
MAX_CHANGES_PER_DAY=8
# 调用接口后等待新 IP 生效的最长时间（秒）
IP_WAIT_TIMEOUT=180

# 被墙检测目标（国内 TCP 端口）。部署后先运行 --check 确认正常时至少有一个可达
CN_TARGETS=114.114.114.114:53,119.29.29.29:53,180.76.76.76:53,223.5.5.5:53
INTL_TARGETS=1.1.1.1:443,8.8.8.8:443,9.9.9.9:443

# ── DDNS（换 IP 后自动更新域名）──
# none       = 不更新（如果你直接用 PQS 后台生成的 DDNS 域名，选这个即可）
# cloudflare = 更新 Cloudflare A 记录
# url        = 换 IP 后 GET 一个地址，可含 {ip} 占位符
DDNS_MODE=none

# Cloudflare：推荐 API Token（权限只给 Zone.DNS:Edit + 该域名），不要用 Global API Key
CF_API_TOKEN=
CF_ZONE_NAME=example.com
CF_RECORD_NAME=node.example.com
# 不推荐的旧方式（全账号权限）：
# CF_EMAIL=
# CF_GLOBAL_KEY=

DDNS_URL=

# ── 家庭探针（国内设备定时连节点端口并上报，发现"只封端口"和线路问题）──
# 用 pqs-guard probe 一键配置。PROBE_PORT=0 表示不启用
PROBE_PORT=0
# 探针上报用的密钥（pqs-guard probe 会自动生成）
PROBE_KEY=
# 探针名称列表，和探针脚本里填的一致，逗号分隔，如 浙江,天津
PROBE_NAMES=
# 要探测的节点端口（x-ui 入站端口），逗号分隔
NODE_PORTS=
# 超过多少秒没上报算离线
PROBE_STALE=600
# 换 IP 后多少秒内不采信探针（等家里 DNS 缓存过期）
PROBE_GRACE=1200

STATE_FILE=/var/lib/pqs-guard/state.json
